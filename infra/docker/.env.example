# Copy to infra/docker/.env on the server. Never commit the real file.
STARTUP_ENV=preview
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Web origins allowed to call the API (Cloudflare Pages preview + production domain)
CORS_ORIGINS=https://startupvn.pages.dev,https://preview.startupvn.pages.dev
# Host port for the API (bound to 127.0.0.1). Pick one not used by other services.
API_PORT=8090
BACKUP_KEEP_DAYS=14
